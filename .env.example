# Copy to .env.local for local dev. On Vercel, add these under Project → Settings → Environment Variables.
# Both values are on Supabase → Project Settings → API. The anon key is designed to be public;
# the database only accepts reads/writes through PIN-checked functions (see supabase/schema.sql).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
